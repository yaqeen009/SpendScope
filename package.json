{
  "name": "spendscope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpendScope — privacy-first personal finance analytics (CSV import, categorisation, budgets, analytics).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @spendscope/api",
    "dev:web": "npm run dev --workspace @spendscope/web",
    "build": "npm run build --workspace @spendscope/api && npm run build --workspace @spendscope/web",
    "start": "npm run start --workspace @spendscope/api",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @spendscope/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @spendscope/api",
    "db:migrate": "npm run db:migrate --workspace @spendscope/api",
    "db:deploy": "npm run db:deploy --workspace @spendscope/api",
    "db:seed": "npm run db:seed --workspace @spendscope/api",
    "db:reset": "npm run db:reset --workspace @spendscope/api",
    "db:studio": "npm run db:studio --workspace @spendscope/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
