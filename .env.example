# ---------------------------------------------------------------------------
# SpendScope environment variables
#
# Copy this file to `.env` at the repository root and adjust the values.
# Never commit a real `.env` file — it is git-ignored on purpose.
#
# The backend reads a single `.env` located at the repository root.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Standard PostgreSQL connection string.
# The default below matches the local development cluster documented in
# docs/LOCAL_POSTGRES.md (PostgreSQL 18 on port 5433, trust auth, local only).
#
# In production, point this at a managed instance over TLS and size the pool for
# the instance, for example:
#   postgresql://user:pw@db.internal:5432/spendscope?schema=public&sslmode=require&connection_limit=5&pool_timeout=10
DATABASE_URL="postgresql://postgres@localhost:5433/spendscope?schema=public"

# Separate database used by the automated test suite. It is wiped between runs.
# Never point this at a database that holds real data.
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/spendscope_test?schema=public"

# Optional: direct (non-pooled) connection string for schema migrations. Managed
# Postgres services that sit behind a pooler (Neon, Supabase, RDS Proxy) hand you
# two URLs: a pooled one for the application and a direct one for migrations,
# pg_dump and pg_restore. Prisma's `migrate deploy` uses this direct URL when it
# is present; the running application always uses the pooled DATABASE_URL above.
# Leave it empty for a plain Postgres with no pooler.
# DATABASE_URL_UNPOOLED="postgresql://user:pw@db.internal:5432/spendscope?schema=public&sslmode=require"

# Optional: dedicated shadow database for `prisma migrate dev`.
# Leave empty to let Prisma create a temporary shadow database automatically.
# SHADOW_DATABASE_URL="postgresql://postgres@localhost:5433/spendscope_shadow?schema=public"

# --- Backend ----------------------------------------------------------------
NODE_ENV="development"
# Port the Express API listens on. Hosting platforms (Render, Railway, Fly,
# Heroku, Vercel) inject PORT themselves — read it from the environment, do not
# hardcode. Render, Railway and Fly all set PORT automatically.
PORT=4000
# Interface to bind. Leave unset on a platform: Node then binds every interface
# (IPv6 `::` with dual-stack when available), which works for the platform's IPv4
# proxy and for IPv6 private networking. Set it only to restrict the listener.
# HOST=127.0.0.1
# Comma-separated list of allowed browser origins (CORS + CSRF origin check).
# In production this must be the real https:// frontend origin.
CORS_ORIGIN="http://localhost:5173"
# Maximum accepted CSV upload size in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880
# Minutes a parsed import preview is retained before expiring.
IMPORT_PREVIEW_TTL_MINUTES=30
# Log level for the structured logger: trace|debug|info|warn|error|fatal
LOG_LEVEL="info"

# --- Proxy ------------------------------------------------------------------
# Number of trusted reverse proxies in front of the API (needed for correct
# client IPs in rate limiting). Leave unset/false when the API is directly
# exposed. Render terminates TLS and proxies to your service in one hop, so
# TRUST_PROXY=1 there. On Railway the API sits behind the platform edge and, in
# the recommended setup, behind the web service's proxy: exactly one hop that
# rewrites X-Forwarded-For, so use TRUST_PROXY=1. Never set it to `true`.
# TRUST_PROXY=1

# --- Authentication ---------------------------------------------------------
# Name of the session cookie.
SESSION_COOKIE_NAME="spendscope_session"
# SameSite attribute: lax | strict | none.
# Keep `lax` whenever the SPA and the API share a registrable domain — including
# the recommended deployment, where the web service proxies /api so the browser
# only sees one origin. `none` is only for a frontend on a *different*
# registrable domain; it requires a Secure cookie and weakens CSRF defence.
SESSION_COOKIE_SAME_SITE="lax"
# How long a session stays valid (hours). Default 30 days.
SESSION_TTL_HOURS=720
# Failed+successful sign-in attempts allowed per address per window.
AUTH_RATE_LIMIT_MAX=20
# Length of the sign-in rate-limit window, in minutes.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Allow new accounts to be created via POST /api/v1/auth/register.
# Set to false once your account exists to close public registration.
ALLOW_REGISTRATION=true
# Create/repair a default workspace on start when none exists.
# MUST be false in production (it would create an unowned workspace).
BOOTSTRAP_DEFAULT_WORKSPACE=true
# Force the Secure attribute on the session cookie. Defaults to true when
# NODE_ENV=production. Only set false for a deliberate local run.
# SESSION_COOKIE_SECURE=true

# --- Production safety valves (deliberate overrides) ------------------------
# The API refuses to start in production when the configuration is unsafe
# (local CORS origin, local database, insecure cookies, bootstrap enabled).
# These two flags acknowledge a deliberately local, production-shaped run
# (for example the docker-compose stack) without weakening the real checks.
# ALLOW_INSECURE_COOKIES=false
# ALLOW_LOCAL_DATABASE_IN_PRODUCTION=false

# --- Frontend ---------------------------------------------------------------
# Vercel: this is a BUILD-TIME variable. Its value is inlined into the JavaScript
# bundle, so changing it later requires a new deployment.
#
# Leave it UNSET for the recommended split deployment. The SPA then calls
# `/api/v1/...` on its own origin and the `vercel.json` rewrite in this
# repository proxies that path to the Render API: one origin, no CORS, and a
# first-party session cookie. The build warns when it is unset; that warning is
# expected in this topology.
#
# Set it only when the browser must call the API on a different origin (for
# example a one-off diagnostic). `vercel.app` and `onrender.com` are both on the
# Public Suffix List, so a direct cross-origin call makes the session cookie a
# third-party cookie, which Safari/iOS and Chrome on Android block. Sign-in
# appears to succeed and then bounces back to the sign-in screen, and
# SESSION_COOKIE_SAME_SITE="none" cannot rescue it. See docs/DEPLOYMENT.md.
# VITE_API_URL="https://api.example.com"

# --- Frontend server (apps/web/server.mjs) ----------------------------------
# The production web server serves the built SPA and, when this is set, proxies
# `/api/*` to the API. On Railway the API's private address is
# http://<service-name>.railway.internal:<PORT>. Leaving it unset means
# "static only": the browser then talks to VITE_API_URL directly.
# API_INTERNAL_URL="http://api.railway.internal:4000"
# Extra `connect-src` origins for the Content-Security-Policy. Only needed when
# the browser calls the API directly on another origin.
# CSP_CONNECT_SRC="https://api.example.com"
# Send Strict-Transport-Security once the domain is verified over HTTPS.
# HSTS_MAX_AGE=31536000
# Access-log level for the web server: info | silent.
# LOG_LEVEL=info
