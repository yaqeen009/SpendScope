# ---------------------------------------------------------------------------
# SpendScope environment variables
#
# Copy this file to `.env` at the repository root and adjust the values.
# Never commit a real `.env` file — it is git-ignored on purpose.
#
# The backend reads a single `.env` located at the repository root.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Standard PostgreSQL connection string.
# The default below matches the local development cluster documented in
# docs/LOCAL_POSTGRES.md (PostgreSQL 18 on port 5433, trust auth, local only).
DATABASE_URL="postgresql://postgres@localhost:5433/spendscope?schema=public"

# Separate database used by the automated test suite. It is wiped between runs.
# Never point this at a database that holds real data.
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/spendscope_test?schema=public"

# Optional: dedicated shadow database for `prisma migrate dev`.
# Leave empty to let Prisma create a temporary shadow database automatically.
# SHADOW_DATABASE_URL="postgresql://postgres@localhost:5433/spendscope_shadow?schema=public"

# --- Backend ----------------------------------------------------------------
NODE_ENV="development"
# Port the Express API listens on.
PORT=4000
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGIN="http://localhost:5173"
# Maximum accepted CSV upload size in bytes (default 5 MiB).
MAX_UPLOAD_BYTES=5242880
# Minutes a parsed import preview is retained in memory before expiring.
IMPORT_PREVIEW_TTL_MINUTES=30
# Log level for the structured logger: trace|debug|info|warn|error|fatal
LOG_LEVEL="info"

# --- Frontend ---------------------------------------------------------------
# Base URL of the API. Used by the Vite dev proxy only if VITE_API_PROXY is set.
VITE_API_BASE_URL="/api/v1"
# Optional: absolute API origin for the web client. Leave unset in development —
# Vite proxies `/api` to http://localhost:4000 (see apps/web/vite.config.ts).
# Set this only when the API is served from a different host in production, e.g.
# VITE_API_URL="https://api.example.com"
