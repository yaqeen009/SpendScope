// SpendScope data model.
//
// Conventions (see docs/DATA_MODEL.md for the full rationale):
//   * Money is stored as a POSITIVE magnitude in DECIMAL(14,2) together with an
//     explicit transaction type. The database never stores signed amounts.
//   * `transactionDate` is a UTC `date` (no time, no timezone) so calendar
//     dates do not shift; `createdAt`/`updatedAt` are UTC timestamps.
//   * Every user-owned row carries a `workspaceId`. The MVP seeds exactly one
//     workspace, but services already scope every query by workspace so adding
//     authentication later does not require a rewrite.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
}

enum ReviewStatus {
  NEEDS_REVIEW
  REVIEWED
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum ImportStatus {
  COMPLETED
  PARTIAL
  FAILED
}

/// An account. Authentication is required for every API operation except
/// register/login/health; a user owns one or more workspaces.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased; unique across the installation.
  email        String    @unique
  name         String
  /// scrypt hash in `scrypt$N$r$p$salt$hash` form. Never returned by the API.
  passwordHash String
  /// Disabled accounts cannot log in; existing sessions are rejected.
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  workspaces   Workspace[]

  @@index([createdAt])
}

/// An opaque, server-side session. Only the SHA-256 hash of the bearer token is
/// stored, so a database read cannot be replayed as a login.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the random session token. Unique because it is the lookup key.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  @@index([userId])
  @@index([expiresAt])
}

/// A tenancy boundary owned by exactly one user.
model Workspace {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  isDemo        Boolean       @default(false)
  /// Nullable only for workspaces created before authentication existed; a
  /// workspace with no owner is not reachable through the API.
  ownerUserId   String?       @db.Uuid
  owner         User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  importBatches ImportBatch[]
  settings      Settings?

  @@index([ownerUserId])
}

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @db.Uuid
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  kind         CategoryKind
  color        String?
  description  String?
  /// True for the catalogue seeded on first run; false for user-created categories.
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  transactions Transaction[]
  budgets      Budget[]

  @@unique([workspaceId, name])
  @@index([workspaceId, kind])
}

model Transaction {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @db.Uuid
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactionDate    DateTime        @db.Date
  description        String
  merchant           String?
  /// Lower-cased, punctuation-stripped merchant used for duplicate detection.
  normalizedMerchant String?
  /// Positive magnitude; sign is expressed by `type`.
  amount             Decimal         @db.Decimal(14, 2)
  type               TransactionType
  categoryId         String?         @db.Uuid
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notes              String?
  reviewStatus       ReviewStatus    @default(NEEDS_REVIEW)
  importBatchId      String?         @db.Uuid
  importBatch        ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// Deterministic hash of date + normalised description + amount + type + merchant.
  fingerprint        String?
  /// True when the row was produced by the demo seed rather than a real import.
  isSample           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([workspaceId, transactionDate])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, type])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, fingerprint])
  @@index([workspaceId, amount])
  @@index([importBatchId])
}

model Budget {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// First day of the budget month, stored as a UTC `date`.
  month       DateTime  @db.Date
  amount      Decimal   @db.Decimal(14, 2)
  /// NULL identifies the single total monthly expense budget.
  categoryId  String?   @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, month, categoryId])
  @@index([workspaceId, month])
}

model ImportBatch {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename      String
  status        ImportStatus
  totalRows     Int
  createdRows   Int          @default(0)
  duplicateRows Int          @default(0)
  invalidRows   Int          @default(0)
  skippedRows   Int          @default(0)
  /// Where the rows came from, e.g. "csv" or "manual" or "seed".
  source        String       @default("csv")
  notes         String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  transactions  Transaction[]

  @@index([workspaceId, createdAt])
}

/// Per-workspace application settings.
///
/// `workspaceId` is the primary key: every workspace has exactly one settings
/// row. (The original schema used a singleton `id = 1`, which cannot represent
/// more than one workspace and was fixed when authentication was introduced.)
model Settings {
  workspaceId   String   @id @db.Uuid
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currency      String   @default("GHS")
  locale        String   @default("en-GH")
  theme         String   @default("system")
  defaultPeriod String   @default("this_month")
  updatedAt     DateTime @updatedAt
}
